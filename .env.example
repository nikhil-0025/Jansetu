# JanSetu (जनसेतु) Application Environment Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/jansetu
JWT_SECRET=jansetu_super_secure_jwt_secret_key_2026_techtrix
NODE_ENV=development

# ==============================================================================
# Indian Government API Integration Layer Configuration
# ==============================================================================
# When credentials are not provided or GOV_API_FORCE_MOCK=true, JanSetu operates
# in safe DEMO_MODE using the JanSetu Simulated Mock Adapter.
# In DEMO_MODE, all responses are clearly labeled: isSimulated: true, isAuthoritative: false.
# ==============================================================================

# Force simulation mock adapter for local testing / offline evaluation
GOV_API_FORCE_MOCK=false
GOV_API_TIMEOUT_MS=6000
GOV_API_RETRY_ATTEMPTS=2

# 1. API Setu (apisetu.gov.in)
# Obtain by registering your entity at https://partners.apisetu.gov.in
APISETU_BASE_URL=https://apisetu.gov.in
APISETU_SANDBOX_URL=https://apisetu.gov.in/developer/sandbox
APISETU_ENV=sandbox
APISETU_CLIENT_ID=
APISETU_API_KEY=
# Optional status override for testing: Connected | Sandbox | Awaiting Approval | Unavailable | Demo Mode
APISETU_STATUS_OVERRIDE=

# 2. DigiLocker Partner Gateway (api.apisetu.gov.in)
DIGILOCKER_PARTNER_ID=
DIGILOCKER_API_SECRET=
DIGILOCKER_CALLBACK_URL=http://localhost:5000/api/government-services/digilocker/callback
DIGILOCKER_CONSENT_VALIDITY_HOURS=24

# 3. Open Government Data Platform India (data.gov.in)
# Register a free developer account at https://data.gov.in to obtain an API key
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
DATA_GOV_API_KEY=
DATA_GOV_NFSA_RESOURCE_ID=9a22a518-5a33-4bab-8d12-1a3c3e6f5c8e
DATA_GOV_PMAY_RESOURCE_ID=8c13b246-4a21-4fca-9e23-2b4c5d6e7f8a

# 4. myScheme National Marketplace (myscheme.gov.in)
MYSCHEME_BASE_URL=https://www.myscheme.gov.in
MYSCHEME_CATALOG_URL=https://api.myscheme.gov.in/api/v1
MYSCHEME_API_KEY=

# 5. State Utility Providers (e.g. UPPCL for Uttar Pradesh Dwelling Verification)
STATE_CODE=UP
DISCOM_UTILITY_CODE=UPPCL
DISCOM_BASE_URL=https://apisetu.gov.in/uppcl/v3
